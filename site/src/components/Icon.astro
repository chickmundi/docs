---
// Inline SVG icons (Lucide, ISC licence) plus a few brand marks. Usage: <Icon name="truck" size={18} />
import * as lucide from 'lucide-static';
import { siWhatsapp } from 'simple-icons';

const BRANDS: Record<string, string> = {
  facebook:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21h3z"/></svg>',
  instagram:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>',
  whatsapp: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="${siWhatsapp.path}"/></svg>`,
  ria:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#ff6b00"/><text x="12" y="15.6" text-anchor="middle" font-family="Arial, sans-serif" font-size="9.5" font-weight="700" fill="#fff">ria</text></svg>',
};

interface Props {
  name: string; // kebab-case Lucide name, e.g. "shopping-cart", or a brand key
  size?: number;
  class?: string;
  label?: string; // accessible label; omit for decorative icons
  strokeWidth?: number;
}
const { name, size = 20, class: cls = '', label, strokeWidth } = Astro.props;
const key = name.replace(/(^|-)(\w)/g, (_, __, c: string) => c.toUpperCase());
let svg = BRANDS[name] ?? ((lucide as Record<string, string>)[key] || (lucide as Record<string, string>).Circle);
svg = svg
  .replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(class|width|height)="[^"]*"/g, ''))
  .replace('<svg', `<svg width="${size}" height="${size}" class="icon ${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`);
if (strokeWidth) svg = svg.replace(/stroke-width="[^"]*"/, `stroke-width="${strokeWidth}"`);
---

<Fragment set:html={svg} />
