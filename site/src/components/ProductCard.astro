---
import type { Product } from '../lib/catalog';
import { money, priceLabel, discountPct } from '../lib/catalog';

interface Props {
  product: Product;
  eager?: boolean;
}
const { product: p, eager = false } = Astro.props;
const img = p.images[0];
const pct = discountPct(p);
const needsOptions = p.type === 'variable' && p.variations.length > 0;
const cartData = JSON.stringify({
  id: p.id,
  name: p.name,
  price: p.price,
  unit: p.unit,
  image: img?.src,
  slug: p.slug,
});
---

<article class="card">
  <a href={`/produit/${p.slug}/`} class="card__media" tabindex="-1" aria-hidden="true">
    {img && <img src={img.src} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width="400" height="400" />}
    <span class="card__badges">
      {pct > 0 && <span class="badge">-{pct}%</span>}
      {!p.inStock && <span class="badge badge--muted">Épuisé</span>}
    </span>
  </a>
  <div class="card__body">
    <h3 class="card__title"><a href={`/produit/${p.slug}/`}>{p.name}</a></h3>
    <p class={`price ${pct ? 'price--sale' : ''}`}>
      {priceLabel(p)}
      {p.unit && <span class="card__unit"> {p.unit}</span>}
      {pct > 0 && <del>{money(p.regularPrice)}</del>}
    </p>
    {
      !p.inStock ? (
        <a class="btn btn--ghost card__btn" href={`/produit/${p.slug}/`}>Voir le produit</a>
      ) : needsOptions ? (
        <a class="btn btn--ghost card__btn" href={`/produit/${p.slug}/`}>Choisir les options</a>
      ) : (
        <button class="btn card__btn" data-add-to-cart={cartData}>Ajouter</button>
      )
    }
  </div>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s, border-color 0.15s;
    min-width: 0;
  }
  .card:hover {
    box-shadow: var(--shadow);
    border-color: #d9d2c6;
  }
  .card__media {
    position: relative;
    aspect-ratio: 1;
    background: #fff;
    display: grid;
    place-items: center;
    padding: 12px;
  }
  .card__media img {
    position: absolute;
    inset: 12px;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
    object-fit: contain;
  }
  .card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    gap: 6px;
  }
  .card__body {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .card__title {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
  }
  .card__title a {
    text-decoration: none;
  }
  .card__title a:hover {
    color: var(--brand);
  }
  .card .price {
    margin: auto 0 0;
    font-size: 1.05rem;
  }
  .card__unit {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }
  .card__btn {
    min-height: 40px;
    font-size: 0.9rem;
    padding: 0 0.8em;
  }
</style>
