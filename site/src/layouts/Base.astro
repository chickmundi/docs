---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { store } from '../config';
import { topCategories, childrenOf, categoryBySlug, money, type Category } from '../lib/catalog';
import { categoryIcon } from '../lib/icons';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { whatsappLink } from '../lib/whatsapp';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = store.tagline, image } = Astro.props;
const fullTitle = title ? `${title} | ${store.name}` : `${store.name} | ${store.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const year = new Date().getFullYear();

// Desktop menu row. "Épicerie" also gathers the other food categories.
const FOOD = ['petit-dejeuner', 'epices-et-condiments', 'surgeles', 'viandes', 'poissons-et-fruits-de-mer', 'fruits-et-legumes'];
const cat = (slug: string) => categoryBySlug(slug)!;
const navGroups: { top: Category; items: Category[] }[] = [
  { top: cat('epicerie'), items: [...childrenOf(cat('epicerie')), ...FOOD.map(cat)].filter(Boolean) },
  { top: cat('perruques'), items: childrenOf(cat('perruques')) },
  { top: cat('extensions-capillaires'), items: childrenOf(cat('extensions-capillaires')) },
  { top: cat('soins-capillaires'), items: childrenOf(cat('soins-capillaires')) },
  { top: cat('soins-corporels'), items: [] },
];
const inGroup = (g: (typeof navGroups)[number]) =>
  [g.top, ...g.items].some((c) => path.startsWith(`/categorie/${c.slug}/`));
// Product and cart pages have their own WhatsApp order buttons.
const showFab = !path.startsWith('/produit/') && !path.startsWith('/panier');
const waService = whatsappLink(`Bonjour ${store.name}, j’ai une question :`);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/brand/favicon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#4a32f0" />
    {import.meta.env.PUBLIC_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>

    <div class="announce">
      <div class="container announce__inner">
        <Icon name="truck" size={16} />
        <p>
          Livraison <strong>GRATUITE</strong> pour toute commande de {money(store.freeDeliveryThreshold)} et plus<span class="announce__more">, jusqu’à {store.maxDeliveryKm} km. Passez votre première commande dès maintenant !</span>
        </p>
      </div>
    </div>

    <div class="utility">
      <div class="container utility__inner">
        <ul class="utility__left">
          <li><Icon name="ria" size={18} /> Transfert d’argent Ria</li>
          <li><Icon name="clock" size={16} /> Nous vous livrons tous les jours de <strong>9 h à 18 h</strong></li>
        </ul>
        <ul class="utility__right">
          <li><a href="/a-propos/">À propos</a></li>
          <li><a href="/livraison/">Livraison</a></li>
          <li><a href="/contact/">Contact</a></li>
          {waService && <li><a href={waService} target="_blank" rel="noopener"><Icon name="whatsapp" size={15} /> WhatsApp</a></li>}
          <li><a href={store.phoneHref}><Icon name="phone" size={14} /> {store.phone}</a></li>
        </ul>
      </div>
    </div>

    <header class="site-header">
      <div class="mainbar">
        <div class="container mainbar__inner">
          <a href="/" class="logo" aria-label={`${store.name}, accueil`}>
            <img src="/images/brand/MRC-logo-whit.png" alt={store.name} width="375" height="117" />
          </a>

          <button class="cats-btn" type="button" data-drawer-open aria-controls="drawer" aria-expanded="false">
            <Icon name="layout-grid" size={18} />
            <span>Catégories</span>
          </button>

          <form class="search" action="/recherche/" role="search">
            <label for="q" class="sr-only">Rechercher un produit</label>
            <input id="q" name="q" type="search" placeholder="Rechercher : gari, perruque, plantain…" autocomplete="off" />
            <button aria-label="Rechercher"><Icon name="search" size={20} /></button>
          </form>

          <nav class="actions" aria-label="Raccourcis">
            <a href={store.phoneHref} class="action action--contact">
              <Icon name="phone" size={22} />
              <span class="action__label">Nous joindre</span>
            </a>
            <a href="/ma-liste/" class="action action--wish" aria-label="Ma liste">
              <span class="action__icon"><Icon name="heart" size={22} /><span class="count" data-wish-count hidden>0</span></span>
              <span class="action__label">Ma liste</span>
            </a>
            <a href="/panier/" class="action" aria-label="Panier">
              <span class="action__icon"><Icon name="shopping-cart" size={22} /><span class="count" data-cart-count hidden>0</span></span>
              <span class="action__label">Panier</span>
            </a>
          </nav>
        </div>
      </div>

      <nav class="menu" aria-label="Menu principal">
        <div class="container menu__inner">
          <ul class="menu__list">
            <li><a href="/" aria-current={isActive('/') ? 'page' : undefined}>Accueil</a></li>
            <li><a href="/boutique/" aria-current={isActive('/boutique') ? 'page' : undefined}>Boutique</a></li>
            {
              navGroups.map((g) => (
                <li class={g.items.length ? 'has-sub' : ''}>
                  <a href={`/categorie/${g.top.slug}/`} aria-current={inGroup(g) ? 'page' : undefined}>
                    {g.top.name}
                    {g.items.length > 0 && <Icon name="chevron-down" size={16} class="menu__chev" />}
                  </a>
                  {g.items.length > 0 && (
                    <div class={`menu__drop ${g.items.length > 6 ? 'menu__drop--wide' : ''}`}>
                      <ul>
                        {g.items.map((c) => (
                          <li>
                            <a href={`/categorie/${c.slug}/`}>
                              <span class="menu__ic"><Icon name={categoryIcon(c.slug)} size={18} /></span>
                              {c.name}
                            </a>
                          </li>
                        ))}
                      </ul>
                      <a class="menu__all" href={`/categorie/${g.top.slug}/`}>
                        Tout voir : {g.top.name} <Icon name="arrow-right" size={16} />
                      </a>
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
          <ul class="menu__list menu__list--end">
            <li><a href="/promotions/" aria-current={isActive('/promotions') ? 'page' : undefined}><Icon name="badge-percent" size={18} /> Promotions</a></li>
            <li><a href="/nouveautes/" class="menu__hot" aria-current={isActive('/nouveautes') ? 'page' : undefined}><Icon name="sparkles" size={18} /> Nouveautés</a></li>
          </ul>
        </div>
      </nav>
    </header>
    <div class="kente" aria-hidden="true"></div>

    <!-- Category panel: "Catégories" button (desktop) and bottom bar (mobile) -->
    <div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="Catégories" hidden>
      <div class="drawer__backdrop" data-drawer-close></div>
      <div class="drawer__panel">
        <div class="drawer__head">
          <strong>Catégories</strong>
          <button class="icon-btn" type="button" aria-label="Fermer" data-drawer-close><Icon name="x" size={22} /></button>
        </div>
        <ul class="drawer__list">
          {
            topCategories.map((c) => {
              const kids = childrenOf(c);
              return (
                <li>
                  {kids.length ? (
                    <details>
                      <summary>
                        <span class="drawer__ic"><Icon name={categoryIcon(c.slug)} size={20} /></span>
                        <span class="drawer__name">{c.name}</span>
                        <Icon name="chevron-down" size={18} class="drawer__chev" />
                      </summary>
                      <ul>
                        <li><a href={`/categorie/${c.slug}/`}>Tout voir</a></li>
                        {kids.map((k) => (
                          <li><a href={`/categorie/${k.slug}/`}>{k.name}</a></li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a href={`/categorie/${c.slug}/`}>
                      <span class="drawer__ic"><Icon name={categoryIcon(c.slug)} size={20} /></span>
                      <span class="drawer__name">{c.name}</span>
                    </a>
                  )}
                </li>
              );
            })
          }
        </ul>
        <ul class="drawer__links">
          <li><a href="/boutique/"><Icon name="store" size={18} /> Tous les produits</a></li>
          <li><a href="/promotions/"><Icon name="badge-percent" size={18} /> Promotions</a></li>
          <li><a href="/nouveautes/"><Icon name="sparkles" size={18} /> Nouveautés</a></li>
          <li><a href="/livraison/"><Icon name="truck" size={18} /> Livraison</a></li>
          <li><a href="/a-propos/"><Icon name="info" size={18} /> À propos</a></li>
          <li><a href="/contact/"><Icon name="phone" size={18} /> Contact</a></li>
        </ul>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="footer wax-bg">
      <div class="kente" aria-hidden="true"></div>
      <div class="container footer__perks">
        <div><Icon name="truck" size={26} /><p><strong>Livraison 7 jours sur 7</strong><span>De 9 h à 18 h, gratuite dès {money(store.freeDeliveryThreshold)}</span></p></div>
        <div><Icon name="store" size={26} /><p><strong>Retrait en magasin</strong><span>Gratuit, au {store.address.street}</span></p></div>
        <div><Icon name="credit-card" size={26} /><p><strong>Paiement flexible</strong><span>En ligne, à la livraison ou en magasin</span></p></div>
        <div><Icon name="shield-check" size={26} /><p><strong>Qualité garantie</strong><span>Des produits choisis avec soin</span></p></div>
      </div>
      <div class="container footer__grid">
        <div>
          <img src="/images/brand/MRC-logo-whit.png" alt={store.name} width="188" height="59" loading="lazy" />
          <p class="footer__tag">{store.tagline}.</p>
          <p class="footer__social">
            <a href={store.social.facebook} rel="noopener" target="_blank" aria-label="Facebook"><Icon name="facebook" size={20} /></a>
            <a href={store.social.instagram} rel="noopener" target="_blank" aria-label="Instagram"><Icon name="instagram" size={20} /></a>
          </p>
        </div>
        <div>
          <h3>Magasin</h3>
          <ul>
            <li><Icon name="map-pin" size={16} /><span>{store.address.street}<br />{store.address.city}, {store.address.region} {store.address.postalCode}</span></li>
            {store.hours.map((h) => <li><Icon name="clock" size={16} /><span>{h.days} : {h.time}</span></li>)}
            <li><Icon name="navigation" size={16} /><a href={store.mapUrl} target="_blank" rel="noopener">Itinéraire</a></li>
          </ul>
        </div>
        <div>
          <h3>Nous joindre</h3>
          <ul>
            <li><Icon name="phone" size={16} /><a href={store.phoneHref}>{store.phone}</a></li>
            <li><Icon name="mail" size={16} /><a href={`mailto:${store.email}`}>{store.email}</a></li>
            {waService && <li><Icon name="whatsapp" size={16} /><a href={waService} target="_blank" rel="noopener">WhatsApp : {store.whatsappDisplay}</a></li>}
            <li><Icon name="truck" size={16} /><span>{store.deliveryHours}</span></li>
            <li><Icon name="banknote" size={16} /><span>Transfert d’argent Ria en magasin</span></li>
          </ul>
        </div>
        <div>
          <h3>Informations</h3>
          <ul class="footer__links">
            <li><a href="/a-propos/">À propos</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/livraison/">Livraison</a></li>
            <li><a href="/conditions-generales/">Conditions générales</a></li>
            <li><a href="/politique-de-remboursement-et-de-retour/">Retours et remboursements</a></li>
            <li><a href="/politique-de-confidentialite/">Confidentialité</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer__bottom">
        <p>© {year} {store.name}. Tous droits réservés.</p>
        <p>Prix en dollars canadiens, taxes en sus s’il y a lieu.</p>
      </div>
    </footer>

    {showFab && <WhatsAppFab />}

    <!-- Mobile bottom bar -->
    <nav class="tabbar" aria-label="Navigation mobile">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}><Icon name="house" size={22} /><span>Accueil</span></a>
      <button type="button" data-drawer-open aria-controls="drawer"><Icon name="layout-grid" size={22} /><span>Catégories</span></button>
      <a href="/recherche/" data-search-jump aria-current={path.startsWith('/recherche') ? 'page' : undefined}><Icon name="search" size={22} /><span>Recherche</span></a>
      <a href="/ma-liste/" aria-current={path.startsWith('/ma-liste') ? 'page' : undefined}>
        <span class="tabbar__icon"><Icon name="heart" size={22} /><span class="count" data-wish-count hidden>0</span></span><span>Ma liste</span>
      </a>
      <a href="/panier/" aria-current={path.startsWith('/panier') ? 'page' : undefined}>
        <span class="tabbar__icon"><Icon name="shopping-cart" size={22} /><span class="count" data-cart-count hidden>0</span></span><span>Panier</span>
      </a>
    </nav>

    <script>
      import '../scripts/cart';
      import '../scripts/wishlist';

      // Category drawer
      const drawer = document.getElementById('drawer')!;
      const openers = document.querySelectorAll<HTMLElement>('[data-drawer-open]');
      let lastFocus: HTMLElement | null = null;
      const setOpen = (open: boolean) => {
        if (open) {
          lastFocus = document.activeElement as HTMLElement;
          drawer.hidden = false;
          requestAnimationFrame(() => drawer.classList.add('is-open'));
          drawer.querySelector<HTMLElement>('summary, a')?.focus();
        } else {
          drawer.classList.remove('is-open');
          setTimeout(() => (drawer.hidden = true), 250);
          lastFocus?.focus();
        }
        document.body.classList.toggle('no-scroll', open);
        openers.forEach((b) => b.setAttribute('aria-expanded', String(open)));
      };
      openers.forEach((b) => b.addEventListener('click', () => setOpen(true)));
      drawer.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && !drawer.hidden && setOpen(false));

      // Mobile "Recherche": jump to the search field when it is on the page
      document.querySelector('[data-search-jump]')?.addEventListener('click', (e) => {
        const q = document.getElementById('q') as HTMLInputElement | null;
        if (!q || location.pathname.startsWith('/recherche')) return;
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        q.focus();
      });

      // Badge bump when the cart or list changes
      const bump = (sel: string) =>
        document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
          el.classList.remove('bump');
          void el.offsetWidth;
          el.classList.add('bump');
        });
      document.addEventListener('cart:change', () => bump('[data-cart-count]'));
      document.addEventListener('wishlist:change', () => bump('[data-wish-count]'));

      // Reveal on scroll
      const io = 'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries) =>
              entries.forEach((en) => {
                if (en.isIntersecting) {
                  en.target.classList.add('is-in');
                  io?.unobserve(en.target);
                }
              }),
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          )
        : null;
      document.querySelectorAll('[data-reveal]').forEach((el) => (io ? io.observe(el) : el.classList.add('is-in')));
    </script>

    <style>
      .skip {
        position: absolute;
        left: -999px;
      }
      .skip:focus {
        left: 16px;
        top: 8px;
        z-index: 100;
        background: #fff;
        padding: 8px 12px;
        border-radius: 8px;
      }
      :global(body.no-scroll) {
        overflow: hidden;
      }

      /* Announcement */
      .announce {
        background: var(--brand);
        color: #fff;
        font-size: 0.84rem;
      }
      .announce__inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 34px;
        text-align: center;
      }
      .announce p {
        margin: 0;
      }
      .announce__more {
        display: none;
      }
      @media (min-width: 700px) {
        .announce__more {
          display: inline;
        }
      }

      /* Utility bar */
      .utility {
        display: none;
        background: var(--navy);
        color: #d8d4f5;
        font-size: 0.84rem;
      }
      @media (min-width: 900px) {
        .utility {
          display: block;
        }
      }
      .utility__inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 38px;
        gap: 16px;
      }
      .utility ul {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .utility li {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .utility__left li + li {
        border-left: 1px solid rgb(255 255 255 / 25%);
        margin-left: 14px;
        padding-left: 14px;
      }
      .utility__left strong {
        color: var(--ochre);
      }
      .utility__right {
        gap: 18px;
      }
      .utility a {
        color: #fff;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .utility a:hover {
        text-decoration: underline;
      }

      /* Sticky header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
      }
      .mainbar {
        background: var(--brand);
        color: #fff;
      }
      .mainbar__inner {
        display: grid;
        grid-template-columns: auto 1fr auto;
        grid-template-areas: 'logo . actions' 'search search search';
        align-items: center;
        gap: 10px 12px;
        padding-top: 10px;
        padding-bottom: 12px;
      }
      .logo {
        grid-area: logo;
      }
      .logo img {
        height: 36px;
        width: auto;
      }
      .cats-btn {
        display: none;
      }
      .search {
        grid-area: search;
        position: relative;
      }
      .actions {
        grid-area: actions;
        display: flex;
        align-items: center;
        gap: 2px;
      }
      @media (min-width: 900px) {
        .mainbar__inner {
          grid-template-columns: auto auto minmax(0, 1fr) auto;
          grid-template-areas: 'logo cats search actions';
          gap: 16px;
          padding-top: 14px;
          padding-bottom: 14px;
        }
        .logo img {
          height: 44px;
        }
        .cats-btn {
          grid-area: cats;
          display: inline-flex;
          align-items: center;
          gap: 10px;
          height: 48px;
          padding: 0 18px;
          border: 0;
          border-radius: 10px;
          background: var(--navy);
          color: #fff;
          font-weight: 700;
          cursor: pointer;
          transition: background 0.2s, transform 0.2s;
        }
        .cats-btn:hover {
          background: #120c4a;
        }
      }
      .search input {
        width: 100%;
        height: 46px;
        border-radius: 12px;
        border: 1.5px solid rgb(255 255 255 / 35%);
        background: rgb(255 255 255 / 14%);
        color: #fff;
        padding: 0 50px 0 16px;
        transition: background 0.2s, border-color 0.2s;
      }
      .search input::placeholder {
        color: rgb(255 255 255 / 80%);
      }
      .search input:focus {
        outline: none;
        background: #fff;
        color: var(--ink);
        border-color: #fff;
      }
      .search input:focus::placeholder {
        color: var(--muted);
      }
      .search button {
        position: absolute;
        right: 4px;
        top: 4px;
        width: 38px;
        height: 38px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: inherit;
        display: grid;
        place-items: center;
        cursor: pointer;
      }
      .search input:focus + button {
        color: var(--brand);
      }
      @media (min-width: 900px) {
        .search input {
          height: 48px;
        }
        .search button {
          top: 5px;
        }
      }
      .action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        border-radius: 10px;
        color: #fff;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: background 0.2s;
      }
      .action:hover {
        background: rgb(255 255 255 / 12%);
      }
      .action__icon {
        position: relative;
        display: inline-flex;
      }
      .action__icon + .action__label {
        margin-left: 6px;
      }
      .action__label,
      .action--wish {
        display: none;
      }
      @media (min-width: 900px) {
        .action--wish {
          display: inline-flex;
        }
      }
      @media (min-width: 1200px) {
        .action__label {
          display: inline;
        }
      }
      .count {
        position: absolute;
        top: -7px;
        right: -9px;
        min-width: 19px;
        height: 19px;
        padding: 0 5px;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 800;
        display: grid;
        place-items: center;
        box-shadow: 0 0 0 2px var(--brand);
      }
      .count[hidden] {
        display: none;
      }

      /* Desktop menu row */
      .menu {
        display: none;
        background: #fff;
        border-bottom: 1px solid var(--line);
      }
      @media (min-width: 1100px) {
        .menu {
          display: block;
        }
      }
      .menu__inner {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
      }
      .menu__list {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .menu__list > li {
        position: relative;
      }
      .menu__list > li > a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 50px;
        padding: 0 12px;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: inset 0 -3px 0 transparent;
        transition: color 0.2s, box-shadow 0.2s;
      }
      .menu__list > li:first-child > a {
        padding-left: 0;
      }
      .menu__list > li > a:hover,
      .menu__list > li > a[aria-current='page'] {
        color: var(--brand);
        box-shadow: inset 0 -3px 0 var(--brand);
      }
      .menu__list :global(.menu__chev) {
        transition: transform 0.2s;
      }
      .has-sub:hover :global(.menu__chev),
      .has-sub:focus-within :global(.menu__chev) {
        transform: rotate(180deg);
      }
      .menu__hot {
        color: var(--accent);
      }
      .menu__list--end > li:last-child > a {
        padding-right: 0;
      }
      .menu__drop {
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 250px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 0 0 14px 14px;
        box-shadow: var(--shadow);
        padding: 10px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(6px);
        transition: opacity 0.18s, transform 0.18s, visibility 0s 0.18s;
        z-index: 5;
      }
      .has-sub:hover .menu__drop,
      .has-sub:focus-within .menu__drop {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition: opacity 0.18s, transform 0.18s;
      }
      .menu__drop ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 2px;
      }
      .menu__drop--wide {
        min-width: 480px;
      }
      .menu__drop--wide ul {
        grid-template-columns: 1fr 1fr;
      }
      .menu__drop a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        transition: background 0.15s;
      }
      .menu__drop a:hover {
        background: var(--brand-soft);
      }
      .menu__ic {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: var(--ochre-soft);
        color: var(--terracotta);
      }
      .menu__all {
        margin-top: 6px;
        border-top: 1px solid var(--line);
        border-radius: 0 !important;
        color: var(--brand);
        padding-top: 12px !important;
      }

      /* Drawer */
      .drawer {
        position: fixed;
        inset: 0;
        z-index: 70;
      }
      .drawer[hidden] {
        display: none;
      }
      .drawer__backdrop {
        position: absolute;
        inset: 0;
        background: rgb(23 20 43 / 50%);
        opacity: 0;
        transition: opacity 0.25s;
      }
      .drawer__panel {
        position: absolute;
        inset: 0 auto 0 0;
        width: min(360px, 88vw);
        background: #fff;
        overflow-y: auto;
        padding: 14px 16px calc(24px + env(safe-area-inset-bottom));
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        box-shadow: var(--shadow);
      }
      .drawer.is-open .drawer__backdrop {
        opacity: 1;
      }
      .drawer.is-open .drawer__panel {
        transform: none;
      }
      .drawer__head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-size: 1.15rem;
        font-family: var(--font-display);
      }
      .icon-btn {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        border: 0;
        background: transparent;
        cursor: pointer;
      }
      .icon-btn:hover {
        background: var(--brand-soft);
      }
      .drawer__list,
      .drawer__links,
      .drawer__list ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .drawer__list > li {
        border-bottom: 1px solid var(--line);
      }
      .drawer__list summary,
      .drawer__list > li > a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 2px;
        min-height: 54px;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        list-style: none;
      }
      .drawer__list summary::-webkit-details-marker {
        display: none;
      }
      .drawer__name {
        flex: 1;
      }
      .drawer__ic {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--ochre-soft);
        color: var(--terracotta);
      }
      .drawer__list :global(.drawer__chev) {
        color: var(--muted);
        transition: transform 0.2s;
      }
      .drawer__list details[open] :global(.drawer__chev) {
        transform: rotate(180deg);
      }
      .drawer__list details ul {
        padding: 0 0 10px 48px;
      }
      .drawer__list details a {
        display: block;
        padding: 8px 0;
        color: var(--muted);
        text-decoration: none;
      }
      .drawer__list a:hover {
        color: var(--brand);
      }
      .drawer__links {
        margin-top: 14px;
        display: grid;
        gap: 2px;
      }
      .drawer__links a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 2px;
        text-decoration: none;
        font-weight: 600;
      }

      /* Mobile bottom bar */
      .tabbar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 60;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        background: #fff;
        border-top: 1px solid var(--line);
        box-shadow: 0 -6px 20px -12px rgb(23 20 43 / 25%);
        padding-bottom: env(safe-area-inset-bottom);
      }
      @media (min-width: 900px) {
        .tabbar {
          display: none;
        }
      }
      .tabbar a,
      .tabbar button {
        display: grid;
        justify-items: center;
        align-content: center;
        gap: 3px;
        height: 64px;
        border: 0;
        background: none;
        color: var(--muted);
        font-size: 0.7rem;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.2s;
      }
      .tabbar a[aria-current='page'] {
        color: var(--brand);
      }
      .tabbar__icon {
        position: relative;
        display: inline-flex;
      }
      .tabbar .count {
        box-shadow: 0 0 0 2px #fff;
      }

      /* Footer */
      .footer {
        margin-top: 56px;
        background: var(--navy);
        color: #d9d6e6;
        font-size: 0.94rem;
      }
      .footer.wax-bg::before {
        filter: invert(1);
        opacity: 0.05;
      }
      .footer__perks {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
        padding-top: 32px;
        padding-bottom: 28px;
        border-bottom: 1px solid rgb(255 255 255 / 12%);
      }
      .footer__perks > div {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        color: var(--ochre);
      }
      .footer__perks p {
        margin: 0;
        display: grid;
        color: #d9d6e6;
      }
      .footer__perks strong {
        color: #fff;
      }
      .footer__perks span {
        font-size: 0.86rem;
      }
      .footer__grid {
        display: grid;
        gap: 28px;
        padding-top: 36px;
        padding-bottom: 28px;
        grid-template-columns: 1fr;
      }
      @media (min-width: 700px) {
        .footer__grid {
          grid-template-columns: 1.3fr 1fr 1fr 1fr;
        }
      }
      .footer h3 {
        color: #fff;
        font-size: 1rem;
        margin-bottom: 12px;
      }
      .footer ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 8px;
      }
      .footer li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
      }
      .footer li :global(.icon) {
        margin-top: 3px;
        color: var(--ochre);
      }
      .footer a {
        text-decoration: none;
      }
      .footer a:hover {
        color: #fff;
        text-decoration: underline;
      }
      .footer img {
        width: 188px;
        height: auto;
      }
      .footer__social {
        display: flex;
        gap: 10px;
      }
      .footer__social a {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgb(255 255 255 / 10%);
        color: #fff;
        transition: background 0.2s, transform 0.2s;
      }
      .footer__social a:hover {
        background: var(--brand);
        transform: translateY(-2px);
      }
      .footer__bottom {
        border-top: 1px solid rgb(255 255 255 / 12%);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        padding-top: 16px;
        padding-bottom: 24px;
        font-size: 0.82rem;
        color: #a19cb5;
      }
      .footer__bottom p {
        margin: 0;
      }

      :global(#toast) {
        position: fixed;
        left: 50%;
        bottom: calc(80px + env(safe-area-inset-bottom));
        transform: translate(-50%, 20px);
        background: var(--ink);
        color: #fff;
        padding: 12px 18px;
        border-radius: 12px;
        box-shadow: var(--shadow);
        opacity: 0;
        transition: 0.25s;
        z-index: 80;
        max-width: calc(100vw - 32px);
        pointer-events: none;
      }
      @media (min-width: 900px) {
        :global(#toast) {
          bottom: 24px;
        }
      }
      :global(#toast.is-visible) {
        opacity: 1;
        transform: translate(-50%, 0);
      }
    </style>
  </body>
</html>
