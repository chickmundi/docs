---
import Base from '../layouts/Base.astro';
---

<Base title="Recherche" description="Rechercher parmi tous les produits de Marché Chemin-du-Roy.">
  <div class="container">
    <h1 class="search-title" data-title>Recherche</h1>
    <p class="muted" data-status>Chargement…</p>
    <div class="grid" data-results></div>
    <noscript><p>La recherche nécessite JavaScript. Parcourez plutôt la <a href="/boutique/">boutique</a>.</p></noscript>
  </div>
</Base>

<script>
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
  const input = document.getElementById('q') as HTMLInputElement | null;
  if (input) input.value = q;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  const title = document.querySelector<HTMLElement>('[data-title]')!;

  (async () => {
    if (!q) {
      status.textContent = 'Tapez un mot dans la barre de recherche, par exemple « gari », « plantain » ou « perruque ».';
      return;
    }
    title.textContent = `Résultats pour « ${q} »`;
    const rows: [string, string, string, string, string, number, string][] = await fetch('/search-index.json').then((r) => r.json());
    const terms = norm(q).split(/\s+/).filter(Boolean);
    const scored = rows
      .map((r) => {
        const name = norm(r[1]);
        const hay = `${name} ${norm(r[2])} ${norm(r[6])}`;
        if (!terms.every((t) => hay.includes(t))) return null;
        let score = terms.reduce((s, t) => s + (name.includes(t) ? 2 : 1) + (name.startsWith(t) ? 2 : 0), 0);
        if (r[5]) score += 1;
        return { r, score };
      })
      .filter(Boolean)
      .sort((a, b) => b!.score - a!.score)
      .slice(0, 96) as { r: (typeof rows)[number] }[];

    status.textContent = scored.length
      ? `${scored.length}${scored.length === 96 ? '+' : ''} produit${scored.length > 1 ? 's' : ''} trouvé${scored.length > 1 ? 's' : ''}`
      : 'Aucun produit trouvé. Essayez un autre mot ou parcourez nos catégories.';

    results.innerHTML = scored
      .map(({ r: [slug, name, cat, price, img, stock] }) => `
        <a class="hit" href="/produit/${slug}/">
          <span class="hit__img">${img ? `<img src="${img}" alt="" loading="lazy" width="200" height="200">` : ''}</span>
          <span class="hit__cat">${esc(cat)}</span>
          <span class="hit__name">${esc(name)}</span>
          <span class="price">${esc(price)}</span>
          ${stock ? '' : '<span class="badge badge--muted">Épuisé</span>'}
        </a>`)
      .join('');
  })();
</script>

<style>
  .search-title {
    margin-top: 28px;
  }
  .muted {
    color: var(--muted);
    margin-bottom: 20px;
  }
  :global(.hit) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px;
    text-decoration: none;
    min-width: 0;
  }
  :global(.hit:hover) {
    box-shadow: var(--shadow);
  }
  :global(.hit__img) {
    position: relative;
    aspect-ratio: 1;
  }
  :global(.hit__img img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  :global(.hit__cat) {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
  }
  :global(.hit__name) {
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  :global(.hit .badge) {
    align-self: flex-start;
  }
</style>
