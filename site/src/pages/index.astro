---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { store } from '../config';
import { minDeliveryFee, maxDeliveryFee } from '../lib/delivery';
import { products, topCategories, categoryBySlug, productsIn, discountPct, money } from '../lib/catalog';

const inStock = products.filter((p) => p.inStock);
const deals = inStock.filter((p) => p.onSale).sort((a, b) => discountPct(b) - discountPct(a)).slice(0, 12);
const newest = [...inStock].sort((a, b) => b.id - a.id).slice(0, 12);
// Pet food and household items live in "Autres"; keep them out of the homepage rails.
const autres = categoryBySlug('autres');
const rail = (slug: string, n = 12) => {
  const c = categoryBySlug(slug);
  return c ? productsIn(c).filter((p) => p.inStock && !(autres && p.categories.includes(autres.id))).slice(0, n) : [];
};
const groups = [
  { slug: 'epicerie', title: 'Épicerie et saveurs d’Afrique', eyebrow: 'Garde-manger' },
  { slug: 'surgeles', title: 'Produits congelés', eyebrow: 'Offrez le meilleur à votre famille' },
  { slug: 'perruques', title: 'Nos perruques', eyebrow: 'Naturel, semi-naturel et synthétique' },
  { slug: 'extensions-capillaires', title: 'Extensions et tresses', eyebrow: 'Crochets, mèches, tissages' },
  { slug: 'soins-capillaires', title: 'Soins capillaires', eyebrow: 'Votre routine beauté' },
].map((g) => ({ ...g, items: rail(g.slug) }));
---

<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Trois-Rivières · depuis le Chemin du Roy</p>
        <h1>Les saveurs d’Afrique et d’ici, <span>livrées chez vous.</span></h1>
        <p class="hero__lead">
          Épicerie africaine et québécoise, viandes et poissons surgelés, perruques, extensions et soins capillaires.
          Plus de {Math.floor(products.length / 100) * 100} produits, en magasin et en ligne.
        </p>
        <div class="hero__cta">
          <a class="btn btn--accent" href="/categorie/epicerie/">Faire l’épicerie</a>
          <a class="btn btn--ghost" href="/categorie/perruques/">Beauté et cheveux</a>
        </div>
        <ul class="hero__facts">
          <li><strong>Livraison gratuite</strong> dès {money(store.freeDeliveryThreshold)}, jusqu’à {store.maxDeliveryKm} km</li>
          <li><strong>7 jours sur 7</strong> de 9 h à 18 h</li>
        </ul>
      </div>
      <div class="hero__art" aria-hidden="true">
        <div class="hero__blob hero__blob--a"><img src="/images/brand/MRC_0008_Layer-1.png" alt="" width="447" height="347" /></div>
        <div class="hero__blob hero__blob--b"><img src="/images/brand/0005_Layer.png" alt="" width="485" height="485" /></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Magasiner par catégorie</h2>
        <a href="/boutique/">Tous les produits →</a>
      </div>
      <ul class="cats">
        {
          topCategories.map((c) => (
            <li>
              <a href={`/categorie/${c.slug}/`}>
                <span class="cats__img">
                  {c.image ? <img src={c.image} alt="" loading="lazy" width="120" height="120" /> : <span class="cats__letter">{c.name[0]}</span>}
                </span>
                <span class="cats__name">{c.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    deals.length > 0 && (
      <section class="section section--tint">
        <div class="container">
          <div class="section__head">
            <div>
              <p class="eyebrow">Dans la limite des stocks</p>
              <h2>Promotions</h2>
            </div>
            <a href="/promotions/">Voir tout →</a>
          </div>
          <div class="grid grid--rail">
            {deals.map((p) => <ProductCard product={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="eyebrow">Cette semaine</p>
          <h2>Nouveautés</h2>
        </div>
        <a href="/boutique/">Voir tout →</a>
      </div>
      <div class="grid grid--rail">
        {newest.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="container">
    <div class="split">
      <a class="split__card split__card--food" href="/categorie/epices-et-condiments/">
        <p class="eyebrow">Une épicerie pas comme les autres</p>
        <h2>Épices, farines et condiments authentiques</h2>
        <span class="btn btn--ghost">Découvrir</span>
        <img src="/images/categories/epices-et-condiments.webp" alt="" loading="lazy" />
      </a>
      <a class="split__card split__card--hair" href="/categorie/soins-capillaires/">
        <p class="eyebrow">Les meilleures offres</p>
        <h2>Transformez votre routine de soins capillaires</h2>
        <span class="btn btn--ghost">Découvrir</span>
        <img src="/images/categories/soins-capillaires.webp" alt="" loading="lazy" />
      </a>
    </div>
  </section>

  {
    groups.map(
      (g) =>
        g.items.length > 0 && (
          <section class="section">
            <div class="container">
              <div class="section__head">
                <div>
                  <p class="eyebrow">{g.eyebrow}</p>
                  <h2>{g.title}</h2>
                </div>
                <a href={`/categorie/${g.slug}/`}>Voir tout →</a>
              </div>
              <div class="grid grid--rail">
                {g.items.map((p) => <ProductCard product={p} />)}
              </div>
            </div>
          </section>
        ),
    )
  }

  <section class="container">
    <div class="visit">
      <div>
        <p class="eyebrow">Venez nous voir</p>
        <h2>{store.address.street}, {store.address.city}</h2>
        <ul>
          {store.hours.map((h) => <li><strong>{h.days}</strong> {h.time}</li>)}
        </ul>
        <p>Dépanneur et marché : produits frais, bières, produits laitiers, articles de maison, et service de transfert d’argent Ria.</p>
        <div class="hero__cta">
          <a class="btn" href={store.mapUrl} target="_blank" rel="noopener">Itinéraire</a>
          <a class="btn btn--ghost" href={store.phoneHref}>{store.phone}</a>
        </div>
      </div>
      <ul class="visit__perks">
        <li><strong>Paiement flexible</strong><span>En ligne, à la livraison ou en magasin.</span></li>
        <li><strong>Qualité garantie</strong><span>Des produits choisis avec soin.</span></li>
        <li><strong>Livraison rapide</strong><span>De {money(minDeliveryFee())} à {money(maxDeliveryFee())} selon la distance, gratuite dès {money(store.freeDeliveryThreshold)}. <a href="/livraison/">Voir les tarifs</a></span></li>
        <li><strong>Arrivages réguliers</strong><span>De nouveaux produits chaque semaine.</span></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(60% 80% at 100% 0%, #e7e2ff 0%, transparent 60%),
      radial-gradient(50% 70% at 0% 100%, #ffe6f0 0%, transparent 60%),
      var(--bg);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: 24px;
    padding-top: 40px;
    padding-bottom: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
      padding-top: 64px;
      padding-bottom: 64px;
    }
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.7rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  .hero h1 span {
    color: var(--brand);
  }
  .hero__lead {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 52ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 22px 0;
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }
  .hero__facts strong {
    color: var(--ink);
  }
  .hero__art {
    position: relative;
    min-height: 260px;
  }
  @media (min-width: 900px) {
    .hero__art {
      min-height: 400px;
    }
  }
  .hero__blob {
    position: absolute;
    border-radius: 44% 56% 52% 48% / 48% 44% 56% 52%;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow);
  }
  .hero__blob img {
    width: 78%;
    height: auto;
  }
  .hero__blob--a {
    background: #fff;
    width: 62%;
    aspect-ratio: 1;
    left: 0;
    top: 6%;
  }
  .hero__blob--b {
    background: var(--brand);
    width: 52%;
    aspect-ratio: 1;
    right: 0;
    bottom: 0;
  }

  .section--tint {
    background: var(--accent-soft);
    margin: 16px 0;
  }

  .cats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    gap: 12px;
  }
  @media (min-width: 900px) {
    .cats {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }
  }
  .cats a {
    display: grid;
    justify-items: center;
    gap: 8px;
    text-align: center;
    text-decoration: none;
    font-weight: 650;
    font-size: 0.9rem;
    line-height: 1.25;
  }
  .cats__img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .cats__img img {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }
  .cats__letter {
    font: 800 2.2rem var(--font-display);
    color: var(--brand);
  }
  .cats a:hover .cats__img {
    border-color: var(--brand);
    transform: translateY(-2px);
  }

  .split {
    display: grid;
    gap: 16px;
    margin: 24px 0;
  }
  @media (min-width: 800px) {
    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
  .split__card {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    padding: 28px;
    min-height: 240px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .split__card h2 {
    max-width: 15ch;
  }
  .split__card .btn {
    margin-top: auto;
    background: #fff;
  }
  .split__card img {
    position: absolute;
    right: -10px;
    bottom: -10px;
    width: 46%;
    max-width: 230px;
    pointer-events: none;
  }
  .split__card--food {
    background: #fff1dc;
  }
  .split__card--hair {
    background: var(--brand-soft);
  }

  .visit {
    display: grid;
    gap: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 28px;
    margin-top: 24px;
  }
  @media (min-width: 900px) {
    .visit {
      grid-template-columns: 1.1fr 1fr;
      padding: 40px;
    }
  }
  .visit ul {
    list-style: none;
    padding: 0;
  }
  .visit > div li {
    margin-bottom: 4px;
  }
  .visit__perks {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    margin: 0;
  }
  .visit__perks li {
    background: var(--bg);
    border-radius: var(--radius);
    padding: 18px;
    display: grid;
    gap: 4px;
  }
  .visit__perks span {
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
