---
import Base from '../layouts/Base.astro';
import DeliveryRates from '../components/DeliveryRates.astro';
import Icon from '../components/Icon.astro';
import { store } from '../config';
---

<Base title="Panier" description="Votre panier Marché Chemin-du-Roy.">
  <div class="container">
    <h1 class="cart-title">Votre panier</h1>

    <div class="cart" data-cart data-email={store.email} data-whatsapp={store.whatsapp}>
      <div class="cart__empty" data-empty hidden>
        <p>Votre panier est vide.</p>
        <a class="btn" href="/boutique/">Continuer mes achats</a>
      </div>

      <div class="cart__layout" data-filled hidden>
        <section aria-label="Articles">
          <div class="ship" data-ship></div>
          <ul class="lines" data-lines></ul>
          <details class="rates-box">
            <summary>Tarifs de livraison</summary>
            <DeliveryRates />
          </details>
        </section>

        <aside class="summary">
          <h2>Récapitulatif</h2>
          <dl>
            <dt>Sous-total</dt><dd data-subtotal></dd>
            <dt>Livraison</dt><dd data-shipping></dd>
            <dt class="summary__total">Total</dt><dd class="summary__total" data-total></dd>
          </dl>
          <p class="summary__note">Taxes (TPS/TVQ) applicables ajoutées à la confirmation. Les articles vendus au poids sont ajustés selon le poids réel.</p>

          <form class="order" data-order novalidate>
            <h2>Passer la commande</h2>
            <fieldset>
              <legend class="sr-only">Mode de réception</legend>
              <label class="radio"><input type="radio" name="mode" value="Livraison" checked /> Livraison</label>
              <label class="radio"><input type="radio" name="mode" value="Retrait en magasin" /> Retrait en magasin</label>
            </fieldset>

            <div class="address" data-address>
              <div class="field combo">
                <label for="street">Adresse (numéro et rue)</label>
                <input
                  class="input"
                  id="street"
                  name="street"
                  autocomplete="off"
                  placeholder="Commencez à taper : 4520 boul. des Réc…"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="street-suggestions"
                />
                <ul class="combo__list" id="street-suggestions" role="listbox" aria-label="Adresses suggérées" hidden></ul>
                <span class="combo__hint" data-suggest-status aria-live="polite"></span>
              </div>
              <div class="address__row">
                <label class="field">App. (facultatif)<input class="input" name="unit" autocomplete="address-line2" /></label>
                <label class="field">Code postal<input class="input" name="postal" autocomplete="postal-code" placeholder="ex. G8T 4B8" /></label>
              </div>
              <label class="field">Ville<input class="input" name="city" autocomplete="address-level2" value={store.address.city} /></label>
              <button type="button" class="btn btn--ghost btn--block" data-calc>Calculer les frais de livraison</button>
              <p class="quote" data-quote role="status" aria-live="polite"></p>
            </div>
            <p class="pickup" data-pickup hidden>Retrait gratuit au {store.address.street}, {store.address.city}. Nous vous appelons quand la commande est prête.</p>

            <label class="field">Nom complet<input class="input" name="name" autocomplete="name" required /></label>
            <label class="field">Téléphone<input class="input" name="phone" type="tel" autocomplete="tel" required /></label>
            <label class="field">Courriel<input class="input" name="email" type="email" autocomplete="email" /></label>
            <label class="field">Note (facultatif)<textarea class="input" name="note" rows="2" placeholder="Heure préférée, instructions…"></textarea></label>
            <p class="form-error" data-form-error role="alert" hidden></p>
            <button class="btn btn--accent btn--block" type="submit"><Icon name="mail" size={19} /> Envoyer ma commande par courriel</button>
            {store.whatsapp && <button class="btn btn--block btn--wa" type="submit" data-via="whatsapp"><Icon name="whatsapp" size={20} /> Commander via WhatsApp</button>}
            <p class="summary__note">
              Votre commande s’ouvre dans votre application de courriel{store.whatsapp && ' ou WhatsApp'}, prête à envoyer. Nous vous rappelons pour confirmer et convenir du paiement (à la livraison, en magasin ou par lien sécurisé).
            </p>
          </form>
        </aside>
      </div>
    </div>
  </div>
</Base>

<script>
  import { getCart, setQty, clearCart, cartTotal, money, type CartItem } from '../scripts/cart';
  import { distanceForAddress, distanceForPlace, suggestAddresses, type Suggestion, type Place } from '../scripts/distance';
  import { quoteDelivery, minDeliveryFee } from '../lib/delivery';
  import { store } from '../config';
  import { Truck, Store, CircleCheck } from 'lucide-static';

  const icon = (svg: string) => svg.replace(/<svg[^>]*>/, (t) => t.replace(/\s(class|width|height)="[^"]*"/g, '')).replace('<svg', '<svg width="18" height="18" class="icon" aria-hidden="true"');
  const ICONS = { truck: icon(Truck), store: icon(Store), check: icon(CircleCheck) };

  const root = document.querySelector<HTMLElement>('[data-cart]')!;
  const email = root.dataset.email!;
  const whatsapp = root.dataset.whatsapp;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const km = (n: number) => `${n.toLocaleString('fr-CA', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} km`;

  const form = $<HTMLFormElement>('[data-order]');
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const isPickup = () => (form.elements.namedItem('mode') as RadioNodeList).value === 'Retrait en magasin';

  // Distance state for the address currently typed in.
  type Dist =
    | { state: 'idle' }
    | { state: 'loading' }
    | { state: 'ok'; km: number; label: string; address: string }
    | { state: 'notfound'; address: string }
    | { state: 'error'; address: string };
  let dist: Dist = { state: 'idle' };
  // Exact map point of a chosen suggestion, valid while the address fields still match it.
  let pinned: { address: string; place: Place } | null = null;

  const addressText = () => {
    const street = field('street').value.trim();
    const city = field('city').value.trim();
    const postal = field('postal').value.trim();
    return street && city ? [street, city, postal, 'QC'].filter(Boolean).join(', ') : '';
  };
  const fullAddress = () => {
    const unit = field('unit').value.trim();
    return [field('street').value.trim() + (unit ? `, app. ${unit}` : ''), field('city').value.trim(), field('postal').value.trim().toUpperCase()]
      .filter(Boolean)
      .join(', ');
  };

  /** True when the map found the street but not the house number typed. */
  const approximate = (label: string) => {
    const num = field('street').value.trim().match(/^\d+/)?.[0];
    return Boolean(num) && !new RegExp(`(^|\\D)${num}(\\D|$)`).test(label);
  };

  /** Fee in cents, or null when unknown / not deliverable. */
  function deliveryFee(subtotal: number): { fee: number | null; label: string; blocked: boolean } {
    if (isPickup()) return { fee: 0, label: 'Gratuit (retrait)', blocked: false };
    if (dist.state === 'ok') {
      const q = quoteDelivery(dist.km, subtotal);
      if (!q.ok) return { fee: null, label: 'Non disponible', blocked: true };
      return { fee: q.fee, label: q.free ? 'Gratuite' : money(q.fee), blocked: false };
    }
    if (dist.state === 'notfound' || dist.state === 'error') return { fee: null, label: 'À confirmer', blocked: false };
    return { fee: null, label: `Dès ${money(minDeliveryFee())}`, blocked: false };
  }

  function renderQuote(subtotal: number) {
    const el = $('[data-quote]');
    el.className = 'quote';
    if (dist.state === 'idle') {
      el.textContent = '';
    } else if (dist.state === 'loading') {
      el.textContent = 'Calcul de la distance…';
    } else if (dist.state === 'ok') {
      const q = quoteDelivery(dist.km, subtotal);
      if (!q.ok) {
        el.classList.add('quote--bad');
        el.innerHTML = `Cette adresse est à <strong>${km(q.km)}</strong> du magasin. Nous ne livrons pas au-delà de ${store.maxDeliveryKm} km : choisissez le <strong>retrait en magasin</strong> ou appelez-nous au ${esc(store.phone)}.`;
      } else {
        el.classList.add('quote--ok');
        el.innerHTML = `<strong>${km(q.km)}</strong> du magasin par la route : livraison <strong>${q.free ? 'gratuite' : money(q.fee)}</strong>${
          q.free ? '' : subtotal < store.freeDeliveryThreshold ? ` (gratuite dès ${money(store.freeDeliveryThreshold)})` : ''
        }.<span class="quote__addr">${esc(dist.label)}</span>${
          approximate(dist.label) ? '<span class="quote__addr">Numéro civique non trouvé sur la carte : distance approximative, confirmée par téléphone.</span>' : ''
        }`;
      }
    } else if (dist.state === 'notfound') {
      el.classList.add('quote--warn');
      el.textContent = 'Adresse introuvable sur la carte. Vérifiez le numéro, la rue et la ville, ou envoyez quand même : nous confirmerons les frais par téléphone.';
    } else {
      el.classList.add('quote--warn');
      el.textContent = 'Le calcul de distance est indisponible pour le moment. Vous pouvez envoyer la commande : nous confirmerons les frais de livraison par téléphone.';
    }
  }

  function render() {
    const items = getCart();
    $('[data-empty]').hidden = items.length > 0;
    $('[data-filled]').hidden = items.length === 0;
    if (!items.length) return;

    const subtotal = cartTotal(items);
    const pickup = isPickup();
    const remaining = store.freeDeliveryThreshold - subtotal;
    $('[data-ship]').innerHTML = pickup
      ? `<p class="ship__line">${ICONS.store} Retrait gratuit en magasin.</p>`
      : remaining > 0
        ? `<p class="ship__line">${ICONS.truck} Plus que <strong>${money(remaining)}</strong> pour la livraison gratuite (jusqu’à ${store.maxDeliveryKm} km).</p><div class="bar"><span style="width:${Math.min(100, (subtotal / store.freeDeliveryThreshold) * 100)}%"></span></div>`
        : `<p class="ship__line">${ICONS.check} Livraison <strong>gratuite</strong> jusqu’à ${store.maxDeliveryKm} km du magasin.</p><div class="bar"><span style="width:100%"></span></div>`;

    const d = deliveryFee(subtotal);
    $('[data-subtotal]').textContent = money(subtotal);
    $('[data-shipping]').textContent = d.label;
    $('[data-total]').textContent = d.fee == null ? `${money(subtotal)} + livraison` : money(subtotal + d.fee);
    renderQuote(subtotal);

    $('[data-lines]').innerHTML = items
      .map(
        (i) => `
      <li class="line">
        <a href="/produit/${i.slug}/" class="line__img">${i.image ? `<img src="${i.image}" alt="" width="80" height="80">` : ''}</a>
        <div class="line__info">
          <a href="/produit/${i.slug}/" class="line__name">${esc(i.name)}</a>
          ${i.variant ? `<span class="line__meta">${esc(i.variant)}</span>` : ''}
          <span class="line__meta">${money(i.price)}${i.unit ? ' ' + esc(i.unit) : ''}</span>
          <button class="line__remove" data-remove="${i.key}">Retirer</button>
        </div>
        <div class="line__qty">
          <div class="qty" role="group" aria-label="Quantité">
            <button type="button" data-qty="${i.key}" data-d="-1" aria-label="Moins">−</button>
            <span>${i.qty}</span>
            <button type="button" data-qty="${i.key}" data-d="1" aria-label="Plus">+</button>
          </div>
          <strong class="price">${money(i.price * i.qty)}</strong>
        </div>
      </li>`,
      )
      .join('');
  }

  async function calculate() {
    const address = addressText();
    if (!address) {
      dist = { state: 'idle' };
      render();
      return;
    }
    if ((dist.state === 'ok' || dist.state === 'notfound') && dist.address === address) return;
    dist = { state: 'loading' };
    render();
    try {
      const r = pinned && pinned.address === address ? await distanceForPlace(pinned.place) : await distanceForAddress(address);
      if (addressText() !== address) return; // address changed meanwhile
      dist = r ? { state: 'ok', km: r.km, label: r.label, address } : { state: 'notfound', address };
    } catch {
      dist = { state: 'error', address };
    }
    render();
  }

  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const q = t.closest<HTMLElement>('[data-qty]');
    if (q) {
      const item = getCart().find((i) => i.key === q.dataset.qty);
      if (item) setQty(item.key, item.qty + Number(q.dataset.d));
    }
    const r = t.closest<HTMLElement>('[data-remove]');
    if (r) setQty(r.dataset.remove!, 0);
    if (t.closest('[data-calc]')) calculate();
  });

  form.addEventListener('change', (e) => {
    const name = (e.target as HTMLInputElement).name;
    if (name === 'mode') {
      $('[data-address]').hidden = isPickup();
      $('[data-pickup]').hidden = !isPickup();
      render();
    }
    // While the suggestion list is open, wait for a choice instead of looking up a half-typed address.
    if (name === 'street' && !list.hidden) return;
    if (['street', 'city', 'postal'].includes(name) && field('street').value.trim()) calculate();
  });

  // ---------- Address autocomplete ----------
  const streetInput = field('street');
  const list = $<HTMLUListElement>('#street-suggestions');
  const suggestStatus = $('[data-suggest-status]');
  let suggestions: Suggestion[] = [];
  let active = -1;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let controller: AbortController | undefined;

  function closeList() {
    list.hidden = true;
    list.innerHTML = '';
    streetInput.setAttribute('aria-expanded', 'false');
    streetInput.removeAttribute('aria-activedescendant');
    active = -1;
  }

  function showSuggestions(items: Suggestion[]) {
    suggestions = items;
    active = -1;
    if (!items.length) {
      closeList();
      return;
    }
    list.innerHTML = items
      .map(
        (s, i) => `<li role="option" id="sugg-${i}" aria-selected="false" data-i="${i}">
          <strong>${esc(s.street)}</strong><span>${esc([s.city, s.postcode].filter(Boolean).join(', '))}${s.hasNumber ? '' : ' · rue'}</span>
        </li>`,
      )
      .join('');
    list.hidden = false;
    streetInput.setAttribute('aria-expanded', 'true');
    suggestStatus.textContent = `${items.length} adresse${items.length > 1 ? 's' : ''} suggérée${items.length > 1 ? 's' : ''}. Flèches pour choisir, Entrée pour valider.`;
  }

  function highlight(i: number) {
    active = (i + suggestions.length) % suggestions.length;
    list.querySelectorAll('[role=option]').forEach((li, j) => li.setAttribute('aria-selected', String(j === active)));
    streetInput.setAttribute('aria-activedescendant', `sugg-${active}`);
    list.querySelector(`#sugg-${active}`)?.scrollIntoView({ block: 'nearest' });
  }

  function choose(i: number) {
    const s = suggestions[i];
    if (!s) return;
    streetInput.value = s.street;
    if (s.city) field('city').value = s.city;
    field('postal').value = s.postcode;
    closeList();
    suggestStatus.textContent = '';
    pinned = { address: addressText(), place: { lat: s.lat, lon: s.lon, label: s.label } };
    dist = { state: 'idle' };
    calculate();
    if (!s.hasNumber) streetInput.focus();
  }

  async function fetchSuggestions() {
    const typed = streetInput.value.trim();
    if (typed.length < 3) {
      closeList();
      return;
    }
    // Add the city when the customer changed it from the default, to narrow the search.
    const city = field('city').value.trim();
    const q = city && city !== store.address.city ? `${typed}, ${city}` : typed;
    controller?.abort();
    controller = new AbortController();
    const signal = controller.signal;
    try {
      let items: Suggestion[];
      try {
        items = await suggestAddresses(q, signal);
      } catch (err) {
        if ((err as Error).name === 'AbortError') throw err;
        await new Promise((r) => setTimeout(r, 700)); // brief network hiccup or rate limit: retry once
        if (signal.aborted) return;
        items = await suggestAddresses(q, signal);
      }
      if (streetInput.value.trim() !== typed) return; // stale
      showSuggestions(items);
    } catch (err) {
      if ((err as Error).name !== 'AbortError') closeList(); // suggestions are optional: the address can still be typed fully
    }
  }

  streetInput.addEventListener('input', () => {
    pinned = null;
    clearTimeout(timer);
    timer = setTimeout(fetchSuggestions, 300);
  });
  streetInput.addEventListener('keydown', (e) => {
    if (list.hidden || !suggestions.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight(active - 1);
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      choose(active);
    } else if (e.key === 'Escape') {
      closeList();
    }
  });
  // mousedown (not click) so the field keeps focus and no half-typed lookup starts.
  list.addEventListener('mousedown', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
    if (!li) return;
    e.preventDefault();
    choose(Number(li.dataset.i));
  });
  streetInput.addEventListener('blur', () => {
    setTimeout(() => {
      if (!list.hidden) {
        closeList();
        if (streetInput.value.trim()) calculate();
      }
    }, 150);
  });
  for (const name of ['city', 'postal']) field(name).addEventListener('input', () => (pinned = null));
  form.addEventListener('input', (e) => {
    const name = (e.target as HTMLInputElement).name;
    if (['street', 'city', 'postal'].includes(name) && dist.state !== 'loading' && dist.state !== 'idle') {
      dist = { state: 'idle' };
      render();
    }
  });

  function orderText(items: CartItem[], f: FormData, fee: number | null, km?: number) {
    const lines = items.map(
      (i) => `- ${i.qty} × ${i.name}${i.variant ? ` (${i.variant})` : ''}${i.unit ? ` [${i.unit}]` : ''} : ${money(i.price * i.qty)}`,
    );
    const subtotal = cartTotal(items);
    const pickup = isPickup();
    return [
      'Bonjour, je souhaite passer la commande suivante :',
      '',
      ...lines,
      '',
      `Sous-total : ${money(subtotal)}`,
      pickup
        ? 'Mode : Retrait en magasin'
        : `Livraison : ${fee == null ? 'à confirmer' : fee === 0 ? 'gratuite' : money(fee)}${km != null ? ` (${km.toFixed(1).replace('.', ',')} km)` : ''}`,
      `Total : ${fee == null ? `${money(subtotal)} + livraison` : money(subtotal + fee)} (taxes en sus s’il y a lieu)`,
      '',
      `Nom : ${f.get('name')}`,
      `Téléphone : ${f.get('phone')}`,
      f.get('email') ? `Courriel : ${f.get('email')}` : '',
      !pickup ? `Adresse : ${fullAddress()}` : '',
      f.get('note') ? `Note : ${f.get('note')}` : '',
    ]
      .filter((l, i, a) => l !== '' || a[i - 1] !== '')
      .join('\n');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('[data-form-error]');
    const fail = (msg: string, focus?: HTMLElement) => {
      err.textContent = msg;
      err.hidden = false;
      focus?.focus();
    };
    err.hidden = true;
    const items = getCart();
    if (!items.length) return;

    if (!isPickup()) {
      if (!field('street').value.trim() || !field('city').value.trim()) return fail('Entrez votre adresse de livraison.', field('street'));
      if (dist.state !== 'ok' || dist.address !== addressText()) await calculate();
    }
    const subtotal = cartTotal(items);
    const d = deliveryFee(subtotal);
    if (d.blocked) return fail(`Livraison impossible au-delà de ${store.maxDeliveryKm} km. Choisissez le retrait en magasin.`);
    if (!field('name').value.trim()) return fail('Entrez votre nom.', field('name'));
    if (!field('phone').value.trim()) return fail('Entrez votre numéro de téléphone.', field('phone'));

    const f = new FormData(form);
    const text = orderText(items, f, d.fee, dist.state === 'ok' ? dist.km : undefined);
    const via = (e.submitter as HTMLElement | null)?.dataset.via;
    const url =
      via === 'whatsapp' && whatsapp
        ? `https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`
        : `mailto:${email}?subject=${encodeURIComponent(`Commande en ligne - ${f.get('name')}`)}&body=${encodeURIComponent(text)}`;
    window.location.href = url;
    setTimeout(() => {
      if (confirm('Votre commande a-t-elle bien été envoyée ? Cliquez OK pour vider le panier.')) clearCart();
    }, 1500);
  });

  document.addEventListener('cart:change', render);
  render();
</script>

<style>
  .cart-title {
    margin-top: 28px;
  }
  .cart__empty {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 40px 24px;
    text-align: center;
  }
  .cart__layout {
    display: grid;
    gap: 24px;
  }
  .cart__layout[hidden],
  .cart__empty[hidden] {
    display: none;
  }
  @media (min-width: 900px) {
    .cart__layout {
      grid-template-columns: minmax(0, 1.5fr) minmax(320px, 1fr);
      align-items: start;
    }
  }
  .ship {
    background: var(--brand-soft);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .ship :global(p) {
    margin: 0 0 8px;
  }
  .ship :global(.ship__line) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ship :global(.ship__line .icon) {
    color: var(--brand);
  }
  .ship :global(.bar) {
    height: 8px;
    border-radius: 99px;
    background: #fff;
    overflow: hidden;
  }
  .ship :global(.bar span) {
    display: block;
    height: 100%;
    background: var(--brand);
  }
  .lines {
    list-style: none;
    padding: 0;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .lines :global(.line) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    padding: 14px;
    border-bottom: 1px solid var(--line);
  }
  .lines :global(.line:last-child) {
    border-bottom: 0;
  }
  @media (min-width: 600px) {
    .lines :global(.line) {
      grid-template-columns: 80px minmax(0, 1fr) auto;
    }
  }
  .lines :global(.line__img img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }
  .lines :global(.line__info) {
    display: grid;
    gap: 2px;
    align-content: start;
  }
  .lines :global(.line__name) {
    font-weight: 650;
    text-decoration: none;
  }
  .lines :global(.line__meta) {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .lines :global(.line__remove) {
    justify-self: start;
    border: 0;
    background: none;
    padding: 4px 0;
    color: var(--accent);
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: underline;
