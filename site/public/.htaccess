# Generated by scripts/import-products.mjs
Options -MultiViews
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Products whose address changed
RewriteRule ^(?:fr|en)/product/tissage-semi-naturel-remy-illusion-natural-kinky-straight-30.*/?$ /produit/tissage-semi-naturel-remy-illusion-natural-kinky-straight-30/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/tissage-semi-naturel-remy-illusion-new-deep-wave-3pcs-18.*-20.*-22.*-4x4-free-part/?$ /produit/tissage-semi-naturel-remy-illusion-new-deep-wave-3pcs-18-20-22-4x4-free-part/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/super-caribe-triple-48.*-3pcs-meche/?$ /produit/super-caribe-triple-48-3pcs-meche/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/3x-x-pression-pre-stretched-braid-58.*/?$ /produit/3x-x-pression-pre-stretched-braid-58/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/10x-x-pression-pre-stretched-braid-48.*/?$ /produit/10x-x-pression-pre-stretched-braid-48/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/butta-lace-wig-hollywood-wave-26.*-hh-mixed/?$ /produit/butta-lace-wig-hollywood-wave-26-hh-mixed/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/what-lace-13x6-hd-human-hair-blend-wig-talisa-12.*/?$ /produit/what-lace-13x6-hd-human-hair-blend-wig-talisa-12/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/butta-lace-human-hair-blend-wig-hh-mixed-water-wave-16.*/?$ /produit/butta-lace-human-hair-blend-wig-hh-mixed-water-wave-16/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/what-lace-human-hair-blend-shiyana-14.*-wig/?$ /produit/what-lace-human-hair-blend-shiyana-14-wig/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/african-collection-3x-ruwa-bohemian-18.*/?$ /produit/african-collection-3x-ruwa-bohemian-18/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/lulutress-crochet-braid-18.*-water-wave/?$ /produit/lulutress-crochet-braid-18-water-wave/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/lulutress-crochet-braid-2x-ocean-wave-8.*/?$ /produit/lulutress-crochet-braid-2x-ocean-wave-8/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/tissage-synthetique-vice-bundle-multi-deep-twist-14.*16.*18.*/?$ /produit/tissage-synthetique-vice-bundle-multi-deep-twist-14-16-18/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/curls-kinks-co.*clip-in-game-changer-10/?$ /produit/curls-kinks-co-clip-in-game-changer-10/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/vitale-olive-oil-hair-mayonnaise-with-oat-protein-pro-vitamins-restores-the-hair-moisturizes-conditions-softens-detangles-paraben-free-net-wt-30-oz-.*-850-g/?$ /produit/vitale-olive-oil-hair-mayonnaise-with-oat-protein-pro-vitamins-restores-the-hair-moisturizes-conditions-softens-detangles-paraben-free-net-wt-30-oz-850-g/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product/what-lace-human-hair-blend-aziza-26.*/?$ /produit/what-lace-human-hair-blend-aziza-26/ [R=301,L,NC]

# Old WooCommerce addresses
RewriteRule ^(?:fr|en)/product/([^/]+)/?$ /produit/$1/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product-category/(?:.*/)?tout/?$ /boutique/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/product-category/(?:[^/]+/)*([^/]+)/?$ /categorie/$1/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/(?:panier|cart|caisse|checkout)/?$ /panier/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/(?:boutique|shop|nouveautes)/?$ /boutique/ [R=301,L,NC]
RewriteRule ^(?:fr|en)/(a-propos|contact|conditions-generales|politique-de-confidentialite|politique-de-remboursement-et-de-retour)/?$ /$1/ [R=301,L,NC]
RewriteRule ^(?:fr|en)(?:/.*)?$ / [R=301,L,NC]
RewriteRule ^(?:product|product-category|wp-content|wp-admin|wp-login\.php)(?:/.*)?$ / [R=301,L,NC]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
